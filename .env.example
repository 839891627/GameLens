# 帧探·GameLens - 环境变量配置示例
#
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 填入你的API密钥
# 3. .env文件不会被提交到Git（已在.gitignore中）
#
# 注意：这些API密钥是可选的，不配置也能正常使用基础功能

# ============================================
# 阿里云百炼 API（可选）
# 用于：场景理解、图像分析增强
# 获取地址：https://dashscope.aliyun.com/
# ============================================
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# 智谱AI API（可选）
# 用于：多模态理解、场景描述
# 获取地址：https://open.bigmodel.cn/
# ============================================
ZHIPU_API_KEY=your_zhipu_api_key_here

# ============================================
# 其他配置
# ============================================
# 抽帧间隔（秒）
FRAME_INTERVAL=5

# 匹配结果数量
TOP_K_RESULTS=5

# 最低相似度阈值（0-1）
MIN_SIMILARITY=0.5
